{
  "name": "@aghoz/fastify",
  "version": "0.4.3",
  "description": "Fastify adapter for Aghoz resumable edge event streams, mounted as a route inside your existing Fastify app.",
  "keywords": [
    "server-sent-events",
    "sse",
    "realtime",
    "real-time",
    "push",
    "server-push",
    "live-updates",
    "streaming",
    "pubsub",
    "websocket-alternative",
    "eventsource",
    "typescript",
    "fastify",
    "fastify-plugin",
    "nodejs",
    "adapter"
  ],
  "homepage": "https://github.com/akosidencio/aghoz#readme",
  "bugs": {
    "url": "https://github.com/akosidencio/aghoz/issues"
  },
  "author": "thinkgrid-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akosidencio/aghoz.git",
    "directory": "packages/fastify"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "fastify": ">=4",
    "@aghoz/server": "workspace:*"
  },
  "devDependencies": {
    "@aghoz/server": "workspace:*",
    "@types/node": "^22.20.1",
    "fastify": "^5.11.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
