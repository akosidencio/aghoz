{
  "name": "@aghoz/svelte",
  "version": "0.5.0",
  "description": "Svelte client for Aghoz — stores for resumable edge event streams with explicit replay gaps.",
  "keywords": [
    "server-sent-events",
    "sse",
    "realtime",
    "real-time",
    "push",
    "server-push",
    "live-updates",
    "streaming",
    "pubsub",
    "websocket-alternative",
    "eventsource",
    "typescript",
    "svelte",
    "sveltekit",
    "stores"
  ],
  "homepage": "https://github.com/akosidencio/aghoz#readme",
  "bugs": {
    "url": "https://github.com/akosidencio/aghoz/issues"
  },
  "author": "thinkgrid-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akosidencio/aghoz.git",
    "directory": "packages/svelte"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "devDependencies": {
    "@aghoz/client": "workspace:*",
    "@aghoz/server": "workspace:*",
    "@types/node": "^22.20.1",
    "svelte": "^5.42.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@aghoz/client": "workspace:*"
  }
}
