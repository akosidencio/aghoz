    "react",
    "react-hooks",
    "hooks",
    "usetopic",
    "tanstack-query",
    "polling"
  ],
  "homepage": "https://github.com/akosidencio/aghoz#readme",
  "bugs": {
    "url": "https://github.com/akosidencio/aghoz/issues"
  },
  "author": "thinkgrid-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akosidencio/aghoz.git",
    "directory": "packages/react"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@aghoz/client": "workspace:*"
  },
  "devDependencies": {
