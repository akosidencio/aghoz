{
  "name": "@aghoz/server",
  "version": "0.4.2",
  "description": "In-process resumable edge event streams for Node.js and Express — mounts as a route so your existing auth runs first. Replay and explicit gaps, zero dependencies.",
  "keywords": [
    "server-sent-events",
    "sse",
    "realtime",
    "real-time",
    "push",
    "server-push",
    "live-updates",
    "streaming",
    "pubsub",
    "websocket-alternative",
    "eventsource",
    "typescript",
    "express",
    "nodejs",
    "node",
    "hub",
    "authorization",
    "polling"
  ],
  "homepage": "https://github.com/akosidencio/aghoz#readme",
  "bugs": {
    "url": "https://github.com/akosidencio/aghoz/issues"
  },
  "author": "thinkgrid-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akosidencio/aghoz.git",
    "directory": "packages/server"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test && node ../../conformance/runner.mjs ./dist/conformance-adapter.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
