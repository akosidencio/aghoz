{
  "name": "@aghoz/history-file",
  "version": "0.4.2",
  "description": "Disk-backed history for aghoz — makes SSE replay survive a process restart, so a deploy does not make every connected client refetch.",
  "keywords": [
    "server-sent-events",
    "sse",
    "realtime",
    "real-time",
    "push",
    "server-push",
    "live-updates",
    "streaming",
    "eventsource",
    "typescript",
    "persistence",
    "durability",
    "replay",
    "append-only-log"
  ],
  "homepage": "https://github.com/akosidencio/aghoz#readme",
  "bugs": {
    "url": "https://github.com/akosidencio/aghoz/issues"
  },
  "author": "thinkgrid-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akosidencio/aghoz.git",
    "directory": "packages/history-file"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "@aghoz/server": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@aghoz/server": "workspace:*"
  }
}
